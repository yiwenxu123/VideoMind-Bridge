{
  "manifest_version": 3,
  "name": "VideoMind Bridge",
  "version": "1.0.1",
  "description": "一键处理视频到VideoMind Bridge - 支持B站、YouTube、抖音、小红书",
  "permissions": [
    "activeTab",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:*/*",
    "http://localhost:*/*",
    "http://[::1]:*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "VideoMind Bridge"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/video/*",
        "*://*.youtube.com/watch*",
        "*://*.douyin.com/*",
        "*://*.xiaohongshu.com/explore/*",
        "*://*.xiaohongshu.com/discovery/item/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
