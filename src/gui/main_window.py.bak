        """)
        self.start_button.setMinimumHeight(45)
        button_layout.addWidget(self.start_button)

        button_layout.addStretch()

        self.open_obsidian_button = QPushButton("📂 打开 Obsidian")
        self.open_obsidian_button.setStyleSheet("""
            QPushButton {
                padding: 10px 20px;
                border-radius: 4px;
                border: 1px solid #ddd;
            }
        """)
        button_layout.addWidget(self.open_obsidian_button)

        self.minimize_button = QPushButton("⏷ 最小化到托盘")
        self.minimize_button.setStyleSheet("""
            QPushButton {
                padding: 10px 20px;
                border-radius: 4px;
                border: 1px solid #ddd;
            }
        """)
        button_layout.addWidget(self.minimize_button)

        self.main_layout.addLayout(button_layout)

        # ===== 7. 任务队列和历史记录（标签页） =====
        from PySide6.QtWidgets import QTabWidget

        self.task_tab_widget = QTabWidget()
        self.task_tab_widget.setStyleSheet("""
            QTabWidget::pane {
                border: 1px solid #ddd;
                border-radius: 4px;
                background-color: white;
            }
            QTabBar::tab {
                padding: 8px 16px;
                margin-right: 2px;
                border: 1px solid #ddd;
                border-bottom: none;
                border-top-left-radius: 4px;
                border-top-right-radius: 4px;
                background-color: #f5f5f5;
            }
            QTabBar::tab:selected {
                background-color: white;
